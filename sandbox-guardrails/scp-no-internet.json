{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoInternetPaths",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:CreateEgressOnlyInternetGateway",
        "ec2:CreateNatGateway",
        "ec2:CreateCarrierGateway",
        "ec2:CreateDefaultVpc",
        "ec2:CreateDefaultSubnet",
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:CreateVpnGateway",
        "ec2:AttachVpnGateway",
        "ec2:CreateCustomerGateway",
        "ec2:CreateVpnConnection",
        "ec2:CreateClientVpnEndpoint",
        "ec2:CreateVpcPeeringConnection",
        "ec2:AcceptVpcPeeringConnection",
        "ec2:CreateTransitGateway",
        "globalaccelerator:*",
        "lightsail:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlyItConnectsToWorkNetwork",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTransitGatewayVpcAttachment",
        "ec2:AcceptTransitGatewayVpcAttachment",
        "networkmanager:*",
        "ram:AcceptResourceShareInvitation"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/<it-network-role>"
        }
      }
    },
    {
      "Sid": "NoPublicIpOnLaunch",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:network-interface/*",
      "Condition": {
        "Bool": {
          "ec2:AssociatePublicIpAddress": "true"
        }
      }
    },
    {
      "Sid": "LambdaMustRunInAVpc",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "lambda:VpcIds": "true"
        }
      }
    },
    {
      "Sid": "NoPublicLambdaUrls",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "NoSageMakerDirectInternet",
      "Effect": "Deny",
      "Action": "sagemaker:CreateNotebookInstance",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sagemaker:DirectInternetAccess": "Enabled"
        }
      }
    },
    {
      "Sid": "KeepS3PublicAccessBlocked",
      "Effect": "Deny",
      "Action": [
        "s3:PutAccountPublicAccessBlock",
        "s3:DeleteAccountPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoLongLivedKeysOrUsers",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlyAwsOwnedVpcEndpoints",
      "Effect": "Deny",
      "Action": "ec2:CreateVpcEndpoint",
      "Resource": "arn:aws:ec2:*:*:vpc-endpoint/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:VpceServiceOwner": "amazon"
        }
      }
    },
    {
      "Sid": "NoOtherWaysOut",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateVpcEndpointServiceConfiguration",
        "vpc-lattice:*",
        "directconnect:*",
        "events:CreateApiDestination",
        "events:CreateConnection",
        "states:InvokeHTTPEndpoint",
        "apprunner:*",
        "cloudshell:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoHttpOrEmailSubscriptions",
      "Effect": "Deny",
      "Action": "sns:Subscribe",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sns:Protocol": [
            "http",
            "https",
            "email",
            "email-json",
            "sms"
          ]
        }
      }
    },
    {
      "Sid": "NoPurchasesOrBilling",
      "Effect": "Deny",
      "Action": [
        "aws-portal:Modify*",
        "billing:Put*",
        "billing:Update*",
        "account:*",
        "organizations:*",
        "savingsplans:CreateSavingsPlan",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "rds:PurchaseReservedDBInstancesOffering",
        "elasticache:PurchaseReservedCacheNodesOffering",
        "route53domains:RegisterDomain",
        "route53domains:TransferDomain",
        "marketplace:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoAuditTampering",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "securityhub:DisableSecurityHub"
      ],
      "Resource": "*"
    }
  ]
}
