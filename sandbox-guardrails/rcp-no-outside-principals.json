{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyOurOrgCanAssumeRolesHere",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "sts:AssumeRole",
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": { "aws:PrincipalOrgID": "ORG_ID" },
        "BoolIfExists": { "aws:PrincipalIsAWSService": "false" }
      }
    }
  ]
}
