#!/bin/bash
# Boot script for the self-hosted runner (Amazon Linux 2023, arm64).
# Rendered by OpenTofu templatefile(): $${x} below is a literal shell $${x}.
set -euxo pipefail
exec > >(tee /var/log/runner-bootstrap.log) 2>&1

PROJECT="${project}"
REGION="${region}"
REPO="${github_repo}"
TOFU_VERSION="${tofu_version}"
RUNNER_HOME=/opt/actions-runner

# 1 GB swap so a t4g.micro (1 GB RAM) doesn't run out of memory mid-plan.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

dnf install -y git jq unzip zip tar libicu krb5-libs openssl-libs python3

# OpenTofu, pinned.
if ! command -v tofu >/dev/null || ! tofu version | grep -q "v$TOFU_VERSION"; then
  curl -fsSLo /tmp/tofu.zip "https://github.com/opentofu/opentofu/releases/download/v$TOFU_VERSION/tofu_$${TOFU_VERSION}_linux_arm64.zip"
  unzip -o /tmp/tofu.zip tofu -d /usr/local/bin && rm /tmp/tofu.zip
fi

# Already registered (e.g. instance was stopped and started): the service just resumes.
if [ -f "$RUNNER_HOME/.runner" ]; then
  exit 0
fi

mkdir -p "$RUNNER_HOME" && chown ec2-user:ec2-user "$RUNNER_HOME"
cd "$RUNNER_HOME"

RUNNER_VERSION="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | jq -r .tag_name | sed 's/^v//')"
curl -fsSLo runner.tgz "https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-arm64-$${RUNNER_VERSION}.tar.gz"
tar xzf runner.tgz && rm runner.tgz
chown -R ec2-user:ec2-user "$RUNNER_HOME"

# The PAT never touches disk; it only buys a one-hour registration token.
PAT="$(aws ssm get-parameter --region "$REGION" --name "/$PROJECT/github-pat" --with-decryption --query Parameter.Value --output text)"
REG_TOKEN="$(curl -fsSL -X POST -H "Authorization: Bearer $PAT" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$REPO/actions/runners/registration-token" | jq -r .token)"
unset PAT

sudo -u ec2-user ./config.sh --unattended --replace \
  --url "https://github.com/$REPO" --token "$REG_TOKEN" \
  --name "$PROJECT-runner" --labels "aws,$PROJECT" --work _work

./svc.sh install ec2-user
./svc.sh start
